# Public Supabase project URL and anonymous key (safe to expose to the browser).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Server-only key used by validated server actions. Never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Recommended admin authentication configuration.
# Generate a hash locally with:
# node -e "const c=require('crypto');const salt=c.randomBytes(16).toString('hex');const key=c.pbkdf2Sync('YOUR_PASSWORD',Buffer.from(salt,'hex'),210000,32,'sha512').toString('hex');console.log(['pbkdf2','sha512','210000',salt,key].join(String.fromCharCode(36)))"
ADMIN_PASSWORD_HASH=pbkdf2$sha512$210000$REPLACE_WITH_SALT$REPLACE_WITH_HASH
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=REPLACE_WITH_A_LONG_RANDOM_VALUE

# Used by the scheduled request to /api/cron/sync. Generate another random value.
CRON_SECRET=REPLACE_WITH_ANOTHER_LONG_RANDOM_VALUE

# Temporary local-development fallback only. Do not set when using ADMIN_PASSWORD_HASH.
# ADMIN_PASSWORD=change-me
